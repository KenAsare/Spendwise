{
  "name": "spendwise-backend",
  "version": "1.0.0",
  "description": "Spendwise - Expense & Budget Management System API",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "mysql2": "^3.11.0",
    "nodemailer": "^10.0.13",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/tests/setup/env.js"],
  "testTimeout": 30000,
  "testMatch": ["<rootDir>/tests/**/*.test.js"]
}
}
