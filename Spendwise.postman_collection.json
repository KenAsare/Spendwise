            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"Food\",\n  \"amount\": 1000,\n  \"month\": 9,\n  \"year\": 2026\n}"
            },
            "url": "{{baseUrl}}/budgets"
          }
        },
        {
          "name": "Create Budget - Duplicate (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"Food\",\n  \"amount\": 1000,\n  \"month\": 9,\n  \"year\": 2026\n}"
            },
            "url": "{{baseUrl}}/budgets"
          }
        },
        {
          "name": "Get All Budgets",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/budgets?month=9&year=2026"
          }
        },
        {
          "name": "Get Budget by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/budgets/{{budgetId}}"
          }
        },
        {
          "name": "Update Budget",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 1200\n}" },
            "url": "{{baseUrl}}/budgets/{{budgetId}}"
          }
        },
        {
          "name": "Delete Budget",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/budgets/{{budgetId}}"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
